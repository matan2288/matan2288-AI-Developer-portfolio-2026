# Optional external AI Studio or hosted Blog App URL for iframe embedding
VITE_BLOG_APP_URL=

# Optional RAG Pipeline Endpoints (Server ONLY - NEVER prefix with VITE_; falls back to Gemini if unreachable or unset)
# Use RAG_URL (full /ask URL) or RAG_API_URL (base URL; /ask is appended automatically)
RAG_URL=http://127.0.0.1:8000/ask
# Optional health-check override (auto-derived for localhost/127.0.0.1; skipped for remote URLs unless set)
RAG_HEALTH_URL=
API_AUTH_TOKEN=

# Gemini API Key (handled automatically in AI Studio, never expose to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Editor Authentication (Admin CMS)
EDITOR_USERNAME=admin
EDITOR_PASSWORD=your_secure_password_here

# Server-Side GitHub Commit Credentials (Netlify Environment Variables / Server ONLY - NEVER EXPOSE TO CLIENT)
GITHUB_TOKEN=
GITHUB_OWNER=matan2288
GITHUB_REPO=
GITHUB_BRANCH=main

# Client-Side GitHub Raw Content Retrieval (Public read-only)
VITE_GITHUB_OWNER=matan2288
VITE_GITHUB_REPO=
VITE_GITHUB_BRANCH=main

# SocialCrawl API Key for LinkedIn Profile Recommendations (Server ONLY)
SOCIALCRAWL_API_KEY=


