# Optional external AI Studio or hosted Blog App URL for iframe embedding
VITE_BLOG_APP_URL=

# Gemini API Key (handled automatically in AI Studio, never expose to client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Editor Authentication (Admin CMS)
EDITOR_USERNAME=admin
EDITOR_PASSWORD=your_secure_password_here

# TinaCloud Production Configuration
# Retrieve these from https://app.tina.io -> Your Project -> Configuration
TINA_CLIENT_ID=
TINA_TOKEN=
TINA_BRANCH=main

# Client-Side Runtime Content Delivery (TinaCloud GraphQL & GitHub Raw)
VITE_TINA_CLIENT_ID=
VITE_TINA_TOKEN=
VITE_TINA_BRANCH=main

# Optional: Direct GitHub Raw Delivery Fallback
VITE_GITHUB_OWNER=
VITE_GITHUB_REPO=

